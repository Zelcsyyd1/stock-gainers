# Copy this file to .env or run: npm run setup.
# Keep real secrets only in .env. Do not commit .env.

# Server
# Used by server.js to choose the local/listening port.
PORT=5000

# Supabase account storage
# Required for login, registration, user profile sync, watchlist sync,
# screening history storage, and persistent auth rate limits.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-side-supabase-key

# Session signing
# Required for login cookies, signed session tokens, email-code hashes,
# and persistent identifier hashes. Use a long random value.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# Cloudflare Turnstile captcha
# Required for registration email-code requests.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# SMTP email delivery
# Required for registration verification-code email delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password-or-app-password
# Optional. Defaults to SMTP_USER when omitted.
SMTP_FROM=your-email@example.com
